{
  "name": "zen-free-gateway",
  "version": "1.0.0",
  "description": "OpenAI 兼容的本地 API 网关,带 IP 轮换自动重置额度",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win dir",
    "dist": "electron-builder --win zip"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "build": {
    "appId": "com.zen.freegateway",
    "productName": "Zen Free Gateway",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "gateway.js",
      "mihomo.js",
      "config.js",
      "config.json",
      "preload.js",
      "renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/mihomo",
        "to": "mihomo",
        "filter": ["**/*"]
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}-win64.${ext}"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
