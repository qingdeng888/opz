# Zen Free Gateway - Docker 部署环境变量示例
#
# 使用方法:
#   cp .env.example .env    # 然后按需修改,注意保密
#   docker compose up -d --build
#
# 所有变量均可选;不设置时按下方注释的默认值。

# 网关监听端口(默认 9527)
# 同时决定 compose 的端口映射,修改后两边自动一致
ZEN_PORT=9527

# 管理面板密码(务必设置强密码)
# 首次启动会写入数据目录 config.json;之后可在管理面板修改
ZEN_ADMIN_PASSWORD=change-me-to-a-strong-password

# 监听地址(默认 0.0.0.0 全网卡,通常无需修改)
ZEN_HOST=0.0.0.0

# 出站代理(可选,留空则直连 opencode.ai):
#   http:127.0.0.1:7890                  HTTP 代理
#   http:user:pass@127.0.0.1:7890        HTTP 代理带认证
#   socks5:127.0.0.1:1080                SOCKS5 代理
#   socks5:user:pass@127.0.0.1:1080      SOCKS5 代理带认证
ZEN_PROXY=

# 免费模型白名单(可选,留空则使用代码内置默认列表)
# 内置默认:big-pickle, ling-3.0-flash-fin-free, mimo-v2.5-free,
#           muse-spark-1.2-contributor-free, muse-spark-1.3-contributor-free,
#           nemotron-3-ultra-free, nemotron-3.5-lightning-free
# 如需自定义,填逗号分隔列表(保存于 config.json,之后可在管理面板增删):
# ZEN_FREE_MODELS=big-pickle,mimo-v2.5-free

# opencode.ai 上游 API Key(可选,免费模型无需设置)
# 网关转发时携带 Authorization: Bearer <key>;
# 付费模型余额充足时可用此 key 接入,面板也可修改
ZEN_UPSTREAM_KEY=
